# CareCredits Level 4 Backend Production Environment Configuration Template
# Copy this file to .env and replace placeholders before deploying.

# Server Environment
PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection
# Format: postgres://username:password@hostname:port/database_name?sslmode=require
DATABASE_URL=postgres://carecredits_admin:secure_password_here@localhost:5432/carecredits_db

# CORS Allowed Origin
# Restrict to your production frontend domain (e.g., https://carecredits.vercel.app)
CORS_ORIGIN=https://carecredits.vercel.app

# Admin Credentials & Auth Secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_in_production
ADMIN_SECRET=generate_a_random_64_character_secret_key_for_jwt_signing
